    DEPARTAMENTO {
        int id_departamento PK
        string nombre
        string presupuesto
        int id_gerente FK
    }

    CARGO {
        int id_cargo PK
        string titulo
        decimal salario_minimo
        decimal salario_maximo
    }

    EMPLEADO {
        int id_empleado PK
        string documento_identidad UK
        string nombres
        string apellidos
        string correo_electronico UK
        string telefono
        date fecha_nacimiento
        date fecha_ingreso
        string estado
        int id_departamento FK
        int id_cargo FK
        int id_supervisor FK
    }

    CONTRATO {
        int id_contrato PK
        int id_empleado FK
        string tipo_contrato
        date fecha_inicio
        date fecha_fin
        decimal salario_base
        string estado
    }

    ASISTENCIA {
        int id_asistencia PK
        int id_empleado FK
        date fecha
        time hora_entrada
        time hora_salida
        decimal horas_extra
    }

    TIPO_AUSENCIA {
        int id_tipo_ausencia PK
        string nombre
        boolean es_remunerada
    }

    SOLICITUD_AUSENCIA {
        int id_solicitud PK
        int id_empleado FK
        int id_tipo_ausencia FK
        date fecha_inicio
        date fecha_fin
        string estado
        int id_aprobador FK
    }

    NOMINA {
        int id_nomina PK
        int id_empleado FK
        date periodo_inicio
        date periodo_fin
        decimal total_devengado
        decimal total_deducciones
        decimal salario_neto
        date fecha_pago
    }

    EVALUACION_DESEMPENO {
        int id_evaluacion PK
        int id_empleado FK
        int id_evaluador FK
        date periodo
        decimal calificacion
        text comentarios
    }

    CURSO_CAPACITACION {
        int id_curso PK
        string titulo
        int horas_duracion
        string instructor
    }

    EMPLEADO_CAPACITACION {
        int id_empleado FK
        int id_curso FK
        date fecha_finalizacion
        string estado
        decimal calificacion
    }